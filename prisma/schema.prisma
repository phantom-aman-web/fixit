generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  emailVerified     DateTime?
  name              String?
  image             String?
  passwordHash      String?
  role              String             @default("CUSTOMER")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  lastSeenAt        DateTime?
  accounts          Account[]
  customerProfile   CustomerProfile?
  sentMessages      Message[]
  notifications     Notification[]
  sessions          Session[]
  technicianProfile TechnicianProfile?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model CustomerProfile {
  id                 String               @id @default(cuid())
  userId             String               @unique
  phone              String?
  city               String               @default("Addis Ababa")
  subCity            String?
  latitude           Float?
  longitude          Float?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  aiChats            AIChat[]
  bookings           Booking[]
  conversations      Conversation[]
  equipment          CustomerEquipment[]
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  diagnosticSessions DiagnosticSession[]
  favorites          FavoriteTechnician[]
  payments           Payment[]
  problemReports     ProblemReport[]
  repairRequests     RepairRequest[]
  reviews            Review[]
  customerReviews    CustomerReview[]
}

model TechnicianProfile {
  id                String                  @id @default(cuid())
  userId            String                  @unique
  displayName       String
  bio               String?
  avatarUrl         String?
  phone             String?
  yearsExperience   Int                     @default(0)
  completedJobs     Int                     @default(0)
  rating            Float                   @default(0)
  ratingCount       Int                     @default(0)
  responseTimeHours Int                     @default(24)
  completionRate    Float                   @default(1.0)
  cancellationRate  Float                   @default(0)
  baseCallOutFee    Int?
  hourlyRate        Int?
  verified          Boolean                 @default(false)
  status            String                  @default("PENDING")
  availability      String                  @default("AVAILABLE")
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  availabilitySlots AvailabilitySlot[]
  bookings          Booking[]
  conversations     Conversation[]
  favorites         FavoriteTechnician[]
  quotes            Quote[]
  repairRequests    RepairRequest[]
  reviews           Review[]
  customerReviews   CustomerReview[]
  serviceAreas      ServiceAreaAssignment[]
  documents         TechnicianDocument[]
  earnings          TechnicianEarnings?
  matches           TechnicianMatch[]
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills            TechnicianSkill[]
}

model TechnicianSkill {
  id                String            @id @default(cuid())
  technicianId      String
  skill             String
  equipmentCategory String?
  proficiency       Int               @default(3)
  createdAt         DateTime          @default(now())
  technician        TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@unique([technicianId, skill, equipmentCategory])
}

model ServiceArea {
  id          String                  @id @default(cuid())
  name        String                  @unique
  city        String                  @default("Addis Ababa")
  latitude    Float
  longitude   Float
  radiusKm    Float                   @default(5)
  assignments ServiceAreaAssignment[]
}

model ServiceAreaAssignment {
  id            String            @id @default(cuid())
  technicianId  String
  serviceAreaId String
  serviceArea   ServiceArea       @relation(fields: [serviceAreaId], references: [id], onDelete: Cascade)
  technician    TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@unique([technicianId, serviceAreaId])
}

model EquipmentCategory {
  id                String               @id @default(cuid())
  slug              String               @unique
  name              String
  icon              String?
  description       String?
  createdAt         DateTime             @default(now())
  customerEquipment CustomerEquipment[]
  questions         DiagnosticQuestion[]
  rules             DiagnosticRule[]
  errorCodes        EquipmentErrorCode[]
  models            EquipmentModel[]
  possibleCauses    PossibleCause[]
  problemReports    ProblemReport[]
  symptoms          Symptom[]
}

model EquipmentModel {
  id         String            @id @default(cuid())
  categoryId String
  brand      String
  model      String
  createdAt  DateTime          @default(now())
  category   EquipmentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, brand, model])
}

model EquipmentErrorCode {
  id                   String            @id @default(cuid())
  categoryId           String
  brand                String?
  modelPattern         String?
  code                 String
  meaning              String
  severity             String            @default("NORMAL")
  riskLevel            String            @default("SAFE")
  possibleCauses       String?
  recommendedActions   String?
  professionalRequired Boolean           @default(false)
  createdAt            DateTime          @default(now())
  category             EquipmentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, code])
}

model CustomerEquipment {
  id                  String              @id @default(cuid())
  customerId          String
  categoryId          String
  brand               String?
  model               String?
  serialNumber        String?
  nickname            String?
  purchaseDate        DateTime?
  notes               String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  customCategoryName  String?
  imageUrls           String[]            @default([])
  category            EquipmentCategory   @relation(fields: [categoryId], references: [id])
  customer            CustomerProfile     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  diagnosticSessions  DiagnosticSession[]
  equipmentWarranties EquipmentWarranty[]
  maintenanceRecords  MaintenanceRecord[]
  problemReports      ProblemReport[]
}

model MaintenanceRecord {
  id          String            @id @default(cuid())
  equipmentId String
  date        DateTime          @default(now())
  type        String
  description String?
  cost        Int?
  createdAt   DateTime          @default(now())
  equipment   CustomerEquipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
}

model ProblemReport {
  id                 String              @id @default(cuid())
  customerId         String
  equipmentId        String?
  categoryId         String
  description        String
  urgency            String              @default("NORMAL")
  status             String              @default("OPEN")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  customCategoryName String?
  customSymptom      String?
  symptomIds         String[]            @default([])
  diagnosticSessions DiagnosticSession[]
  media              ProblemMedia[]
  category           EquipmentCategory   @relation(fields: [categoryId], references: [id])
  customer           CustomerProfile     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  equipment          CustomerEquipment?  @relation(fields: [equipmentId], references: [id])
  repairRequest      RepairRequest?
}

model ProblemMedia {
  id        String        @id @default(cuid())
  problemId String
  url       String
  fileName  String
  mimeType  String
  sizeBytes Int
  type      String
  createdAt DateTime      @default(now())
  problem   ProblemReport @relation(fields: [problemId], references: [id], onDelete: Cascade)
}

model Conversation {
  id           String            @id @default(cuid())
  customerId   String
  technicianId String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  customer     CustomerProfile   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  technician   TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@unique([customerId, technicianId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Symptom {
  id          String               @id @default(cuid())
  categoryId  String
  slug        String
  name        String
  description String?
  createdAt   DateTime             @default(now())
  questions   DiagnosticQuestion[]
  category    EquipmentCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, slug])
}

model DiagnosticQuestion {
  id         String             @id @default(cuid())
  categoryId String
  symptomId  String?
  key        String
  text       String
  helpText   String?
  inputType  String
  order      Int                @default(0)
  required   Boolean            @default(true)
  createdAt  DateTime           @default(now())
  options    DiagnosticOption[]
  category   EquipmentCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  symptom    Symptom?           @relation(fields: [symptomId], references: [id], onDelete: Cascade)

  @@unique([categoryId, key])
}

model DiagnosticOption {
  id         String             @id @default(cuid())
  questionId String
  value      String
  label      String
  order      Int                @default(0)
  question   DiagnosticQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model DiagnosticRule {
  id             String            @id @default(cuid())
  categoryId     String
  symptomId      String?
  questionKey    String
  optionValue    String?
  operator       String            @default("eq")
  causeId        String
  weight         Float             @default(1.0)
  escalate       Boolean           @default(false)
  escalateReason String?
  createdAt      DateTime          @default(now())
  category       EquipmentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  cause          PossibleCause     @relation(fields: [causeId], references: [id], onDelete: Cascade)
}

model PossibleCause {
  id                      String                @id @default(cuid())
  categoryId              String
  slug                    String
  name                    String
  description             String?
  riskLevel               String                @default("SAFE")
  baseConfidence          Float                 @default(0.5)
  professionalRecommended Boolean               @default(false)
  createdAt               DateTime              @default(now())
  diagnoses               Diagnosis[]
  rules                   DiagnosticRule[]
  category                EquipmentCategory     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  troubleshootingSteps    TroubleshootingStep[]
}

model TroubleshootingStep {
  id               String                 @id @default(cuid())
  causeId          String
  title            String
  description      String
  difficulty       String                 @default("EASY")
  estimatedMinutes Int
  safetyLevel      String                 @default("SAFE")
  requiredTools    String?
  instructions     String
  expectedResult   String?
  failureResult    String?
  order            Int                    @default(0)
  createdAt        DateTime               @default(now())
  results          DiagnosticStepResult[]
  cause            PossibleCause          @relation(fields: [causeId], references: [id], onDelete: Cascade)
}

model DiagnosticSession {
  id                       String                 @id @default(cuid())
  customerId               String
  problemId                String?
  equipmentId              String?
  categoryId               String
  symptomId                String?
  symptomSlug              String?
  status                   String                 @default("IN_PROGRESS")
  currentQuestionKey       String?
  answersJson              String?
  possibleCausesJson       String?
  recommendationJson       String?
  confidence               Float?
  riskLevel                String?
  escalationRecommendation String?
  startedAt                DateTime               @default(now())
  completedAt              DateTime?
  updatedAt                DateTime               @updatedAt
  aiAnalyses               AIAnalysis[]
  aiInteractions           AIInteraction[]
  diagnoses                Diagnosis[]
  answers                  DiagnosticAnswer[]
  customer                 CustomerProfile        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  equipment                CustomerEquipment?     @relation(fields: [equipmentId], references: [id])
  problem                  ProblemReport?         @relation(fields: [problemId], references: [id])
  stepResults              DiagnosticStepResult[]
  repairRequest            RepairRequest?

  @@index([customerId, status])
}

model DiagnosticAnswer {
  id           String            @id @default(cuid())
  sessionId    String
  questionKey  String
  questionText String
  valuesJson   String
  createdAt    DateTime          @default(now())
  session      DiagnosticSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionKey])
}

model Diagnosis {
  id         String            @id @default(cuid())
  sessionId  String
  causeId    String
  confidence Float
  reasoning  String
  rank       Int
  createdAt  DateTime          @default(now())
  cause      PossibleCause     @relation(fields: [causeId], references: [id])
  session    DiagnosticSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, causeId])
}

model DiagnosticStepResult {
  id          String              @id @default(cuid())
  sessionId   String
  stepId      String
  status      String
  notes       String?
  attemptedAt DateTime            @default(now())
  session     DiagnosticSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  step        TroubleshootingStep @relation(fields: [stepId], references: [id])
}

model RepairRequest {
  id            String             @id @default(cuid())
  customerId    String
  problemId     String             @unique
  sessionId     String?            @unique
  technicianId  String?
  status        String             @default("OPEN")
  preferredDate DateTime?
  notes         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  booking       Booking?
  quote         Quote?
  customer      CustomerProfile    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  problem       ProblemReport      @relation(fields: [problemId], references: [id], onDelete: Cascade)
  session       DiagnosticSession? @relation(fields: [sessionId], references: [id])
  technician    TechnicianProfile? @relation(fields: [technicianId], references: [id])
  matches       TechnicianMatch[]

  @@index([customerId, status])
  @@index([technicianId, status])
}

model TechnicianMatch {
  id              String            @id @default(cuid())
  repairRequestId String
  technicianId    String
  score           Float
  rank            Int
  explanationJson String
  createdAt       DateTime          @default(now())
  repairRequest   RepairRequest     @relation(fields: [repairRequestId], references: [id], onDelete: Cascade)
  technician      TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@unique([repairRequestId, technicianId])
}

model Quote {
  id                     String            @id @default(cuid())
  repairRequestId        String            @unique
  technicianId           String
  inspectionFee          Int               @default(0)
  labor                  Int               @default(0)
  partsTotal             Int               @default(0)
  taxesFees              Int               @default(0)
  totalEstimate          Int
  currency               String            @default("ETB")
  notes                  String?
  estimatedDurationHours Int?
  expiresAt              DateTime?
  warrantyMonths         Int?
  status                 String            @default("SUBMITTED")
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  booking                Booking?
  repairRequest          RepairRequest     @relation(fields: [repairRequestId], references: [id], onDelete: Cascade)
  technician             TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  items                  QuoteItem[]
}

model QuoteItem {
  id          String @id @default(cuid())
  quoteId     String
  description String
  quantity    Int    @default(1)
  unitPrice   Int
  total       Int
  quote       Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

model Booking {
  id              String            @id @default(cuid())
  repairRequestId String            @unique
  customerId      String
  technicianId    String
  quoteId         String?           @unique
  scheduledAt     DateTime
  location        String
  notes           String?
  status          String            @default("REQUESTED")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  appointment     Appointment?
  customer        CustomerProfile   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  quote           Quote?            @relation(fields: [quoteId], references: [id])
  repairRequest   RepairRequest     @relation(fields: [repairRequestId], references: [id], onDelete: Cascade)
  technician      TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  payment         Payment?
  repairJob       RepairJob?

  @@index([customerId, status])
  @@index([technicianId, status])
}

model RepairJob {
  id            String                   @id @default(cuid())
  bookingId     String                   @unique
  status        String                   @default("SCHEDULED")
  diagnosis     String?
  workPerformed String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  dispute       Dispute?
  inspection    RepairInspection?
  booking       Booking                  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  parts         RepairPart[]
  statusHistory RepairStatusHistory[]
  review        Review?
  customerReview CustomerReview?
  locationPings TechnicianLocationPing[]
  warranty      Warranty?
}

model RepairStatusHistory {
  id        String    @id @default(cuid())
  jobId     String
  status    String
  note      String?
  createdAt DateTime  @default(now())
  job       RepairJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model RepairPart {
  id         String    @id @default(cuid())
  jobId      String
  name       String
  partNumber String?
  quantity   Int       @default(1)
  unitCost   Int
  totalCost  Int
  job        RepairJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model Payment {
  id                        String          @id @default(cuid())
  bookingId                 String          @unique
  customerId                String
  amount                    Int
  currency                  String          @default("ETB")
  status                    String          @default("PENDING")
  provider                  String          @default("mock")
  createdAt                 DateTime        @default(now())
  paidAt                    DateTime?
  failedAt                  DateTime?
  failureReason             String?
  metadataJson              String?
  providerCheckoutSessionId String?
  providerPaymentId         String?
  refundedAt                DateTime?
  booking                   Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer                  CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Review {
  id                    String            @id @default(cuid())
  jobId                 String            @unique
  customerId            String
  technicianId          String
  rating                Int
  title                 String?
  body                  String?
  qualityRating         Int?
  professionalismRating Int?
  communicationRating   Int?
  valueRating           Int?
  createdAt             DateTime          @default(now())
  customer              CustomerProfile   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  job                   RepairJob         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  technician            TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@index([technicianId])
}

model CustomerReview {
  id                    String            @id @default(cuid())
  jobId                 String            @unique
  customerId            String
  technicianId          String
  rating                Int
  title                 String?
  body                  String?
  createdAt             DateTime          @default(now())
  customer              CustomerProfile   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  job                   RepairJob         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  technician            TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model Warranty {
  id             String          @id @default(cuid())
  jobId          String          @unique
  startDate      DateTime        @default(now())
  endDate        DateTime
  durationMonths Int
  coveredWork    String
  status         String          @default("ACTIVE")
  createdAt      DateTime        @default(now())
  documentUrl    String?
  job            RepairJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  claims         WarrantyClaim[]
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  dataJson  String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model AIAnalysis {
  id               String             @id @default(cuid())
  sessionId        String?
  customerId       String
  requestType      String
  provider         String             @default("zai")
  model            String?
  resultJson       String?
  accepted         Boolean            @default(true)
  rejectionReason  String?
  safetyDecision   String             @default("PASS")
  confidence       Float?
  fellBack         Boolean            @default(false)
  fallbackReason   String?
  latencyMs        Int?
  tokensUsed       Int?
  estimatedCostUsd Float?             @default(0)
  createdAt        DateTime           @default(now())
  session          DiagnosticSession? @relation(fields: [sessionId], references: [id])
  hypotheses       AIHypothesis[]
  messages         AIInteraction[]
  observations     AIObservation[]

  @@index([sessionId])
  @@index([customerId])
  @@index([requestType])
}

model AIInteraction {
  id             String            @id @default(cuid())
  sessionId      String
  analysisId     String?
  role           String
  content        String
  structuredJson String?
  createdAt      DateTime          @default(now())
  analysis       AIAnalysis?       @relation(fields: [analysisId], references: [id])
  session        DiagnosticSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model AIObservation {
  id              String     @id @default(cuid())
  analysisId      String
  mediaId         String?
  observationType String
  description     String
  extractedData   String?
  createdAt       DateTime   @default(now())
  analysis        AIAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
}

model AIHypothesis {
  id                    String     @id @default(cuid())
  analysisId            String
  causeName             String
  explanation           String
  confidence            Float
  safetyLevel           String     @default("SAFE")
  supportingEvidence    String?
  contradictingEvidence String?
  requiredVerification  String?
  verified              Boolean    @default(false)
  matchedCauseId        String?
  createdAt             DateTime   @default(now())
  analysis              AIAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
}

model AIChat {
  id                  String          @id @default(cuid())
  customerId          String
  title               String          @default("New Diagnosis")
  messagesJson        String          @default("[]")
  diagnosticSessionId String?         @unique
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  customer            CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, updatedAt])
}

model AIUsageRecord {
  id               String   @id @default(cuid())
  userId           String
  sessionId        String?
  requestType      String
  provider         String
  model            String?
  status           String
  latencyMs        Int?
  tokensUsed       Int?
  estimatedCostUsd Float?   @default(0)
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
  @@index([requestType, createdAt])
}

model AvailabilitySlot {
  id           String            @id @default(cuid())
  technicianId String
  dayOfWeek    Int?
  specificDate DateTime?
  startMinutes Int
  endMinutes   Int
  isBlock      Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  technician   TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@index([technicianId, dayOfWeek])
  @@index([technicianId, specificDate])
}

model Appointment {
  id          String                  @id @default(cuid())
  bookingId   String                  @unique
  scheduledAt DateTime
  endsAt      DateTime?
  status      String                  @default("REQUESTED")
  proposedBy  String?
  notes       String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  booking     Booking                 @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  history     AppointmentReschedule[]
}

model AppointmentReschedule {
  id            String      @id @default(cuid())
  appointmentId String
  previousTime  DateTime
  newTime       DateTime
  proposedBy    String
  reason        String?
  createdAt     DateTime    @default(now())
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

model TechnicianLocationPing {
  id         String    @id @default(cuid())
  jobId      String
  latitude   Float
  longitude  Float
  etaMinutes Int?
  isDemo     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  job        RepairJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
}

model RepairInspection {
  id                String    @id @default(cuid())
  jobId             String    @unique
  observedIssue     String?
  physicalCondition String?
  diagnosticChecks  String?
  errorCodes        String?
  suspectedParts    String?
  safetyConcerns    String?
  notes             String?
  photosJson        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  job               RepairJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model Dispute {
  id           String           @id @default(cuid())
  jobId        String           @unique
  customerId   String
  technicianId String
  reason       String
  description  String
  status       String           @default("OPEN")
  resolution   String?
  resolvedBy   String?
  refundAmount Int?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  job          RepairJob        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  messages     DisputeMessage[]

  @@index([status])
  @@index([customerId])
  @@index([technicianId])
}

model DisputeMessage {
  id         String   @id @default(cuid())
  disputeId  String
  authorId   String
  authorRole String
  message    String
  createdAt  DateTime @default(now())
  dispute    Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@index([disputeId, createdAt])
}

model WarrantyClaim {
  id          String   @id @default(cuid())
  warrantyId  String
  customerId  String
  description String
  status      String   @default("OPEN")
  resolution  String?
  resolvedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  warranty    Warranty @relation(fields: [warrantyId], references: [id], onDelete: Cascade)

  @@index([warrantyId])
  @@index([status])
}

model TechnicianDocument {
  id           String            @id @default(cuid())
  technicianId String
  type         String
  fileName     String
  storageKey   String
  status       String            @default("PENDING")
  reviewedBy   String?
  reviewNote   String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  technician   TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@index([technicianId, status])
}

model NotificationPreference {
  id                   String   @id @default(cuid())
  userId               String   @unique
  bookingUpdates       Boolean  @default(true)
  repairUpdates        Boolean  @default(true)
  paymentNotifications Boolean  @default(true)
  warrantyReminders    Boolean  @default(true)
  reviewRequests       Boolean  @default(true)
  disputeUpdates       Boolean  @default(true)
  marketing            Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model FavoriteTechnician {
  id           String            @id @default(cuid())
  customerId   String
  technicianId String
  createdAt    DateTime          @default(now())
  customer     CustomerProfile   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  technician   TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@unique([customerId, technicianId])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  actorRole    String?
  action       String
  entityType   String
  entityId     String?
  metadataJson String?
  createdAt    DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
}

model TechnicianEarnings {
  id                String            @id @default(cuid())
  technicianId      String            @unique
  totalEarnings     Int               @default(0)
  pendingPayouts    Int               @default(0)
  completedPayouts  Int               @default(0)
  jobsThisMonth     Int               @default(0)
  earningsThisMonth Int               @default(0)
  updatedAt         DateTime          @updatedAt
  technician        TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)
}

model IdempotencyKey {
  id             String   @id @default(cuid())
  key            String   @unique
  userId         String
  operation      String
  requestHash    String
  responseStatus Int      @default(200)
  responseJson   String?
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@index([userId, operation])
  @@index([expiresAt])
}

model PaymentWebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventId     String    @unique
  eventType   String
  payloadHash String
  status      String    @default("PENDING")
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@index([provider, eventType])
  @@index([status])
}

model OutboxEvent {
  id            String    @id @default(cuid())
  type          String
  aggregateType String
  aggregateId   String?
  payload       String
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  maxAttempts   Int       @default(3)
  availableAt   DateTime  @default(now())
  processedAt   DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  failedAt      DateTime?
  updatedAt     DateTime  @default(now()) @updatedAt

  @@index([status, availableAt])
  @@index([createdAt])
  @@index([type, status])
}

model EquipmentWarranty {
  id          String            @id @default(cuid())
  equipmentId String
  provider    String
  startDate   DateTime
  endDate     DateTime
  notes       String?
  receiptUrl  String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  equipment   CustomerEquipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
}
