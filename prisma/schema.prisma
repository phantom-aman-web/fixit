// FixIt — Prisma schema (Phase 1: SQLite)
// Enum-like fields are String (SQLite has no native enums); validated in src/types via zod.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ──────────────────────────────── Identity & Auth ────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?
  role          String    @default("CUSTOMER") // CUSTOMER | TECHNICIAN | ADMIN
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  customerProfile   CustomerProfile?
  technicianProfile TechnicianProfile?
  notifications     Notification[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model CustomerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone     String?
  city      String   @default("Addis Ababa")
  subCity   String? // Bole, Kazanchis, ...
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  equipment          CustomerEquipment[]
  problemReports     ProblemReport[]
  diagnosticSessions DiagnosticSession[]
  repairRequests     RepairRequest[]
  bookings           Booking[]
  payments           Payment[]
  reviews            Review[]
  favorites          FavoriteTechnician[]
  aiChats            AIChat[]
}

model TechnicianProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName       String
  bio               String?
  avatarUrl         String?
  phone             String?
  yearsExperience   Int      @default(0)
  completedJobs     Int      @default(0)
  rating            Float    @default(0)
  ratingCount       Int      @default(0)
  responseTimeHours Int      @default(24)
  completionRate    Float    @default(1.0)
  cancellationRate  Float    @default(0)
  baseCallOutFee    Int? // minor units
  hourlyRate        Int? // minor units
  verified          Boolean  @default(false)
  status            String   @default("PENDING") // PENDING | ACTIVE | SUSPENDED
  availability      String   @default("AVAILABLE") // AVAILABLE | BUSY | OFFLINE
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  skills            TechnicianSkill[]
  serviceAreas      ServiceAreaAssignment[]
  matches           TechnicianMatch[]
  repairRequests    RepairRequest[]
  quotes            Quote[]
  bookings          Booking[]
  reviews           Review[]
  availabilitySlots AvailabilitySlot[]
  documents         TechnicianDocument[]
  favorites         FavoriteTechnician[]
  earnings          TechnicianEarnings?
}

model TechnicianSkill {
  id                String            @id @default(cuid())
  technicianId      String
  technician        TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  skill             String // e.g. "appliance_repair"
  equipmentCategory String? // category slug
  proficiency       Int               @default(3) // 1-5
  createdAt         DateTime          @default(now())

  @@unique([technicianId, skill, equipmentCategory])
}

model ServiceArea {
  id        String @id @default(cuid())
  name      String @unique // Bole, Kazanchis...
  city      String @default("Addis Ababa")
  latitude  Float
  longitude Float
  radiusKm  Float  @default(5)

  assignments ServiceAreaAssignment[]
}

model ServiceAreaAssignment {
  id            String            @id @default(cuid())
  technicianId  String
  technician    TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  serviceAreaId String
  serviceArea   ServiceArea       @relation(fields: [serviceAreaId], references: [id], onDelete: Cascade)

  @@unique([technicianId, serviceAreaId])
}

// ──────────────────────────────── Equipment ─────────────────────────────────────

model EquipmentCategory {
  id          String   @id @default(cuid())
  slug        String   @unique // washing_machine, refrigerator...
  name        String
  icon        String?
  description String?
  createdAt   DateTime @default(now())

  models            EquipmentModel[]
  errorCodes        EquipmentErrorCode[]
  symptoms          Symptom[]
  questions         DiagnosticQuestion[]
  possibleCauses    PossibleCause[]
  rules             DiagnosticRule[]
  customerEquipment CustomerEquipment[]
  problemReports    ProblemReport[]
}

model EquipmentModel {
  id         String            @id @default(cuid())
  categoryId String
  category   EquipmentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  brand      String
  model      String
  createdAt  DateTime          @default(now())

  @@unique([categoryId, brand, model])
}

model EquipmentErrorCode {
  id                   String            @id @default(cuid())
  categoryId           String
  category             EquipmentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  brand                String?
  modelPattern         String? // E.g. "GSR*"
  code                 String
  meaning              String
  severity             String            @default("NORMAL") // LOW | NORMAL | HIGH | EMERGENCY
  riskLevel            String            @default("SAFE") // SAFE | CAUTION | PROFESSIONAL_ONLY
  possibleCauses       String?
  recommendedActions   String?
  professionalRequired Boolean           @default(false)
  createdAt            DateTime          @default(now())

  @@index([categoryId, code])
}

model CustomerEquipment {
  id           String            @id @default(cuid())
  customerId   String
  customer     CustomerProfile   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  categoryId   String
  category     EquipmentCategory @relation(fields: [categoryId], references: [id])
  brand        String?
  model        String?
  serialNumber String?
  nickname     String?
  purchaseDate DateTime?
  notes        String?
  imageUrl     String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  problemReports     ProblemReport[]
  diagnosticSessions DiagnosticSession[]
  maintenanceRecords MaintenanceRecord[]
}

model MaintenanceRecord {
  id          String            @id @default(cuid())
  equipmentId String
  equipment   CustomerEquipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  date        DateTime          @default(now())
  type        String // cleaning, inspection, filter_change...
  description String?
  cost        Int? // minor units
  createdAt   DateTime          @default(now())
}

// ──────────────────────────────── Problems ──────────────────────────────────────

model ProblemReport {
  id          String             @id @default(cuid())
  customerId  String
  customer    CustomerProfile    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  equipmentId String?
  equipment   CustomerEquipment? @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  categoryId  String
  category    EquipmentCategory  @relation(fields: [categoryId], references: [id])
  description String
  urgency     String             @default("NORMAL") // LOW | NORMAL | HIGH | EMERGENCY
  status      String             @default("OPEN") // OPEN | DIAGNOSED | ESCALATED | RESOLVED | ARCHIVED
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  media              ProblemMedia[]
  diagnosticSessions DiagnosticSession[]
  repairRequest      RepairRequest?
}

model ProblemMedia {
  id        String        @id @default(cuid())
  problemId String
  problem   ProblemReport @relation(fields: [problemId], references: [id], onDelete: Cascade)
  url       String // storage key
  fileName  String
  mimeType  String
  sizeBytes Int
  type      String // image | video
  createdAt DateTime      @default(now())
}

// ──────────────────────────── Diagnostic engine ─────────────────────────────────

model Symptom {
  id          String            @id @default(cuid())
  categoryId  String
  category    EquipmentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  slug        String // loud_noise_during_spin
  name        String
  description String?
  createdAt   DateTime          @default(now())

  questions DiagnosticQuestion[]

  @@unique([categoryId, slug])
}

model DiagnosticQuestion {
  id         String            @id @default(cuid())
  categoryId String
  category   EquipmentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  symptomId  String?
  symptom    Symptom?          @relation(fields: [symptomId], references: [id], onDelete: Cascade)
  key        String // when_does_noise_happen
  text       String
  helpText   String?
  inputType  String // SINGLE_SELECT | MULTI_SELECT | TEXT | NUMBER | BOOLEAN
  order      Int               @default(0)
  required   Boolean           @default(true)
  createdAt  DateTime          @default(now())

  options DiagnosticOption[]

  @@unique([categoryId, key])
}

model DiagnosticOption {
  id         String             @id @default(cuid())
  questionId String
  question   DiagnosticQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  value      String // during_spinning
  label      String
  order      Int                @default(0)
}

// Rule: if questionKey answered with optionValue (operator), contribute weight to causeId,
// OR escalate.
model DiagnosticRule {
  id             String            @id @default(cuid())
  categoryId     String
  category       EquipmentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  symptomId      String?
  questionKey    String
  optionValue    String?
  operator       String            @default("eq") // eq | ne | contains | any
  causeId        String
  cause          PossibleCause     @relation(fields: [causeId], references: [id], onDelete: Cascade)
  weight         Float             @default(1.0)
  escalate       Boolean           @default(false)
  escalateReason String?
  createdAt      DateTime          @default(now())
}

model PossibleCause {
  id                      String            @id @default(cuid())
  categoryId              String
  category                EquipmentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  slug                    String
  name                    String
  description             String?
  riskLevel               String            @default("SAFE") // SAFE | CAUTION | PROFESSIONAL_ONLY
  baseConfidence          Float             @default(0.5)
  professionalRecommended Boolean           @default(false)
  createdAt               DateTime          @default(now())

  rules                DiagnosticRule[]
  troubleshootingSteps TroubleshootingStep[]
  diagnoses            Diagnosis[]
}

model TroubleshootingStep {
  id               String        @id @default(cuid())
  causeId          String
  cause            PossibleCause @relation(fields: [causeId], references: [id], onDelete: Cascade)
  title            String
  description      String
  difficulty       String        @default("EASY") // EASY | MODERATE | ADVANCED
  estimatedMinutes Int
  safetyLevel      String        @default("SAFE") // SAFE | CAUTION | PROFESSIONAL_ONLY
  requiredTools    String? // comma separated
  instructions     String
  expectedResult   String?
  failureResult    String?
  order            Int           @default(0)
  createdAt        DateTime      @default(now())

  results DiagnosticStepResult[]
}

// ──────────────────────────── Diagnostic sessions ───────────────────────────────

model DiagnosticSession {
  id                       String             @id @default(cuid())
  customerId               String
  customer                 CustomerProfile    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  problemId                String?
  problem                  ProblemReport?     @relation(fields: [problemId], references: [id], onDelete: SetNull)
  equipmentId              String?
  equipment                CustomerEquipment? @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  categoryId               String
  symptomId                String?
  symptomSlug              String?
  status                   String             @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED | ESCALATED | ABANDONED
  currentQuestionKey       String?
  answersJson              String? // JSON { questionKey: string[] }
  possibleCausesJson       String? // JSON array of {causeId, confidence}
  recommendationJson       String?
  confidence               Float?
  riskLevel                String? // SAFE | CAUTION | PROFESSIONAL_ONLY
  escalationRecommendation String?
  startedAt                DateTime           @default(now())
  completedAt              DateTime?
  updatedAt                DateTime           @updatedAt

  answers        DiagnosticAnswer[]
  diagnoses      Diagnosis[]
  stepResults    DiagnosticStepResult[]
  repairRequest  RepairRequest?
  aiAnalyses     AIAnalysis[]
  aiInteractions AIInteraction[]

  @@index([customerId, status])
}

model DiagnosticAnswer {
  id           String            @id @default(cuid())
  sessionId    String
  session      DiagnosticSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionKey  String
  questionText String
  valuesJson   String // JSON string[] of selected option values
  createdAt    DateTime          @default(now())

  @@unique([sessionId, questionKey])
}

model Diagnosis {
  id         String            @id @default(cuid())
  sessionId  String
  session    DiagnosticSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  causeId    String
  cause      PossibleCause     @relation(fields: [causeId], references: [id])
  confidence Float
  reasoning  String
  rank       Int
  createdAt  DateTime          @default(now())

  @@unique([sessionId, causeId])
}

model DiagnosticStepResult {
  id          String              @id @default(cuid())
  sessionId   String
  session     DiagnosticSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  stepId      String
  step        TroubleshootingStep @relation(fields: [stepId], references: [id])
  status      String // ATTEMPTED | SOLVED | FAILED | SKIPPED
  notes       String?
  attemptedAt DateTime            @default(now())
}

// ──────────────────────────── Repair lifecycle ──────────────────────────────────

model RepairRequest {
  id            String             @id @default(cuid())
  customerId    String
  customer      CustomerProfile    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  problemId     String             @unique
  problem       ProblemReport      @relation(fields: [problemId], references: [id], onDelete: Cascade)
  sessionId     String?            @unique
  session       DiagnosticSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  technicianId  String?
  technician    TechnicianProfile? @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  status        String             @default("OPEN") // OPEN | MATCHED | TECHNICIAN_SELECTED | QUOTED | BOOKED | COMPLETED | CANCELLED
  preferredDate DateTime?
  notes         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  matches TechnicianMatch[]
  quote   Quote?
  booking Booking?

  @@index([customerId, status])
  @@index([technicianId, status])
}

model TechnicianMatch {
  id              String            @id @default(cuid())
  repairRequestId String
  repairRequest   RepairRequest     @relation(fields: [repairRequestId], references: [id], onDelete: Cascade)
  technicianId    String
  technician      TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  score           Float
  rank            Int
  explanationJson String // JSON breakdown
  createdAt       DateTime          @default(now())

  @@unique([repairRequestId, technicianId])
}

model Quote {
  id                     String            @id @default(cuid())
  repairRequestId        String            @unique
  repairRequest          RepairRequest     @relation(fields: [repairRequestId], references: [id], onDelete: Cascade)
  technicianId           String
  technician             TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  inspectionFee          Int               @default(0)
  labor                  Int               @default(0)
  partsTotal             Int               @default(0)
  taxesFees              Int               @default(0)
  totalEstimate          Int
  currency               String            @default("ETB")
  notes                  String?
  estimatedDurationHours Int?
  expiresAt              DateTime?
  warrantyMonths         Int?
  status                 String            @default("SUBMITTED") // SUBMITTED | APPROVED | REJECTED | EXPIRED
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  items   QuoteItem[]
  booking Booking?
}

model QuoteItem {
  id          String @id @default(cuid())
  quoteId     String
  quote       Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  description String
  quantity    Int    @default(1)
  unitPrice   Int
  total       Int
}

model Booking {
  id              String            @id @default(cuid())
  repairRequestId String            @unique
  repairRequest   RepairRequest     @relation(fields: [repairRequestId], references: [id], onDelete: Cascade)
  customerId      String
  customer        CustomerProfile   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  technicianId    String
  technician      TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  quoteId         String?           @unique
  quote           Quote?            @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  scheduledAt     DateTime
  location        String
  notes           String?
  status          String            @default("REQUESTED") // REQUESTED | ACCEPTED | SCHEDULED | CONFIRMED | CANCELLED | COMPLETED
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  repairJob   RepairJob?
  payment     Payment?
  appointment Appointment?

  @@index([customerId, status])
  @@index([technicianId, status])
}

model RepairJob {
  id            String    @id @default(cuid())
  bookingId     String    @unique
  booking       Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  status        String    @default("SCHEDULED")
  // SCHEDULED | EN_ROUTE | ARRIVED | INSPECTING | DIAGNOSING | QUOTE_SUBMITTED
  // | AWAITING_APPROVAL | REPAIRING | COMPLETED | CANCELLED
  diagnosis     String?
  workPerformed String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  statusHistory RepairStatusHistory[]
  parts         RepairPart[]
  warranty      Warranty?
  review        Review?
  locationPings TechnicianLocationPing[]
  inspection    RepairInspection?
  dispute       Dispute?
}

model RepairStatusHistory {
  id        String    @id @default(cuid())
  jobId     String
  job       RepairJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status    String
  note      String?
  createdAt DateTime  @default(now())
}

model RepairPart {
  id         String    @id @default(cuid())
  jobId      String
  job        RepairJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name       String
  partNumber String?
  quantity   Int       @default(1)
  unitCost   Int
  totalCost  Int
}

model Payment {
  id          String          @id @default(cuid())
  bookingId   String          @unique
  booking     Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customerId  String
  customer    CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount      Int
  currency    String          @default("ETB")
  status      String          @default("PENDING") // PENDING | SUCCEEDED | FAILED | REFUNDED
  provider    String          @default("mock")
  providerRef String?
  createdAt   DateTime        @default(now())
  paidAt      DateTime?
}

model Review {
  id                    String            @id @default(cuid())
  jobId                 String            @unique
  job                   RepairJob         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  customerId            String
  customer              CustomerProfile   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  technicianId          String
  technician            TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  rating                Int // 1-5
  title                 String?
  body                  String?
  qualityRating         Int?
  professionalismRating Int?
  communicationRating   Int?
  valueRating           Int?
  createdAt             DateTime          @default(now())

  @@index([technicianId])
}

model Warranty {
  id             String    @id @default(cuid())
  jobId          String    @unique
  job            RepairJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  startDate      DateTime  @default(now())
  endDate        DateTime
  durationMonths Int
  coveredWork    String
  status         String    @default("ACTIVE") // ACTIVE | EXPIRED | VOIDED
  createdAt      DateTime  @default(now())

  claims WarrantyClaim[]
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // booking_accepted | quote_submitted | ...
  title     String
  body      String
  dataJson  String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

// ──────────────────────────── Phase 2: AI layer ────────────────────────────────

// A single AI analysis record — one provider call, one structured result.
// Linked to a diagnostic session for auditability.
model AIAnalysis {
  id               String             @id @default(cuid())
  sessionId        String?
  session          DiagnosticSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  customerId       String
  requestType      String // interpret_problem | clarify | explain_step | analyze_image | technician_brief | repair_summary | match_explain
  provider         String             @default("zai")
  model            String?
  // Structured result (validated by Zod). Null if validation failed.
  resultJson       String?
  // Whether FixIt accepted or rejected the AI result after safety validation.
  accepted         Boolean            @default(true)
  rejectionReason  String?
  // Safety gate decision.
  safetyDecision   String             @default("PASS") // PASS | DOWNGRADED | REJECTED | ESCALATE
  // Confidence reported by the AI (0..1).
  confidence       Float?
  // Whether FixIt fell back to deterministic logic after this call.
  fellBack         Boolean            @default(false)
  fallbackReason   String?
  latencyMs        Int?
  tokensUsed       Int?
  estimatedCostUsd Float?             @default(0)
  createdAt        DateTime           @default(now())

  messages     AIInteraction[]
  observations AIObservation[]
  hypotheses   AIHypothesis[]

  @@index([sessionId])
  @@index([customerId])
  @@index([requestType])
}

// Individual conversation messages within an AI-assisted session.
model AIInteraction {
  id             String            @id @default(cuid())
  sessionId      String
  session        DiagnosticSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  analysisId     String?
  analysis       AIAnalysis?       @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  role           String // user | assistant | system
  content        String
  // Structured data extracted from this message (e.g. extracted symptoms).
  structuredJson String?
  createdAt      DateTime          @default(now())

  @@index([sessionId])
}

// A visual observation from image analysis.
model AIObservation {
  id              String     @id @default(cuid())
  analysisId      String
  analysis        AIAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  mediaId         String?
  observationType String // OBSERVED | INFERRED | UNKNOWN
  description     String
  // Optional extracted data (error code, model number, visible damage).
  extractedData   String? // JSON
  createdAt       DateTime   @default(now())
}

// A diagnostic hypothesis generated by AI.
model AIHypothesis {
  id                    String     @id @default(cuid())
  analysisId            String
  analysis              AIAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  causeName             String
  explanation           String
  confidence            Float
  safetyLevel           String     @default("SAFE") // SAFE | CAUTION | PROFESSIONAL_ONLY
  supportingEvidence    String? // JSON array
  contradictingEvidence String? // JSON array
  requiredVerification  String?
  // Whether FixIt's deterministic engine could verify this hypothesis against
  // known causes. Unverified hypotheses are shown as uncertain.
  verified              Boolean    @default(false)
  matchedCauseId        String?
  createdAt             DateTime   @default(now())
}

// ──────────────────────────── AI Chat History ──────────────────────────────
// Stores lightweight chat history before a DiagnosticSession is created.
model AIChat {
  id                  String          @id @default(cuid())
  customerId          String
  customer            CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  title               String          @default("New Diagnosis")
  messagesJson        String          @default("[]") // JSON array of Message objects
  diagnosticSessionId String?         @unique
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([customerId, updatedAt])
}

// Aggregate usage tracking for cost control + admin analytics.
model AIUsageRecord {
  id               String   @id @default(cuid())
  userId           String
  sessionId        String?
  requestType      String
  provider         String
  model            String?
  status           String // SUCCESS | FAILED | TIMEOUT | VALIDATION_FAILED | FALLBACK
  latencyMs        Int?
  tokensUsed       Int?
  estimatedCostUsd Float?   @default(0)
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
  @@index([requestType, createdAt])
}

// ──────────────────────────── Phase 3: Operational layer ───────────────────────

// Technician availability slots — real availability, not hardcoded.
// A slot represents a time window the technician is available for bookings.
model AvailabilitySlot {
  id           String            @id @default(cuid())
  technicianId String
  technician   TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  // Day of week 0=Sunday .. 6=Saturday, OR a specific date for one-off blocks.
  dayOfWeek    Int? // 0-6 for recurring weekly slots
  specificDate DateTime? // for one-off availability or blocks (date only, time in startMinutes/endMinutes)
  startMinutes Int // minutes from midnight (e.g. 540 = 9:00 AM)
  endMinutes   Int // minutes from midnight (e.g. 1020 = 5:00 PM)
  isBlock      Boolean           @default(false) // true = unavailable period, false = available slot
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([technicianId, dayOfWeek])
  @@index([technicianId, specificDate])
}

// Appointment — the scheduled date/time for a booking. Separated from Booking
// so reschedules are tracked without losing history.
model Appointment {
  id          String    @id @default(cuid())
  bookingId   String    @unique
  booking     Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  scheduledAt DateTime
  endsAt      DateTime?
  status      String    @default("REQUESTED") // REQUESTED | CONFIRMED | RESCHEDULED | CANCELLED | COMPLETED
  proposedBy  String? // userId who proposed this time
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  history AppointmentReschedule[]
}

model AppointmentReschedule {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  previousTime  DateTime
  newTime       DateTime
  proposedBy    String // userId
  reason        String?
  createdAt     DateTime    @default(now())
}

// Technician location ping — privacy-conscious. Only stored during active
// service windows (EN_ROUTE → ARRIVED). Deleted or voided after job completion.
model TechnicianLocationPing {
  id         String    @id @default(cuid())
  jobId      String
  job        RepairJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  latitude   Float
  longitude  Float
  etaMinutes Int?
  isDemo     Boolean   @default(true) // Phase 3: no real GPS — clearly marked demo
  createdAt  DateTime  @default(now())

  @@index([jobId, createdAt])
}

// Structured technician inspection — recorded during the INSPECTING phase.
model RepairInspection {
  id                String    @id @default(cuid())
  jobId             String    @unique
  job               RepairJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  observedIssue     String?
  physicalCondition String?
  diagnosticChecks  String? // JSON array of {check, result}
  errorCodes        String? // JSON array of strings
  suspectedParts    String? // JSON array
  safetyConcerns    String? // JSON array
  notes             String?
  photosJson        String? // JSON array of media keys
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// Dispute — customer can open, technician responds, admin resolves.
model Dispute {
  id           String    @id @default(cuid())
  jobId        String    @unique
  job          RepairJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  customerId   String
  technicianId String
  reason       String // repair_quality | unexpected_charge | incomplete_work | other
  description  String
  status       String    @default("OPEN") // OPEN | UNDER_REVIEW | RESOLVED | REJECTED
  resolution   String?
  resolvedBy   String? // admin userId
  refundAmount Int? // minor units, if refund issued
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  messages DisputeMessage[]

  @@index([status])
  @@index([customerId])
  @@index([technicianId])
}

model DisputeMessage {
  id         String   @id @default(cuid())
  disputeId  String
  dispute    Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  authorId   String // userId
  authorRole String // customer | technician | admin
  message    String
  createdAt  DateTime @default(now())

  @@index([disputeId, createdAt])
}

// Warranty claim — customer can claim against an active warranty.
model WarrantyClaim {
  id          String   @id @default(cuid())
  warrantyId  String
  warranty    Warranty @relation(fields: [warrantyId], references: [id], onDelete: Cascade)
  customerId  String
  description String
  status      String   @default("OPEN") // OPEN | APPROVED | REJECTED | RESOLVED
  resolution  String?
  resolvedBy  String? // admin or technician userId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([warrantyId])
  @@index([status])
}

// Technician verification documents — submitted by tech, reviewed by admin.
model TechnicianDocument {
  id           String            @id @default(cuid())
  technicianId String
  technician   TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  type         String // identity | certification | insurance | other
  fileName     String
  storageKey   String
  status       String            @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewedBy   String? // admin userId
  reviewNote   String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([technicianId, status])
}

// Notification preferences — users control which notifications they receive.
model NotificationPreference {
  id                   String   @id @default(cuid())
  userId               String   @unique
  bookingUpdates       Boolean  @default(true)
  repairUpdates        Boolean  @default(true)
  paymentNotifications Boolean  @default(true)
  warrantyReminders    Boolean  @default(true)
  reviewRequests       Boolean  @default(true)
  disputeUpdates       Boolean  @default(true)
  marketing            Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// Favorite technicians — customers can bookmark technicians.
model FavoriteTechnician {
  id           String            @id @default(cuid())
  customerId   String
  customer     CustomerProfile   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  technicianId String
  technician   TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  createdAt    DateTime          @default(now())

  @@unique([customerId, technicianId])
}

// Audit log — important administrative and workflow actions.
model AuditLog {
  id           String   @id @default(cuid())
  actorId      String? // userId, null for system
  actorRole    String? // CUSTOMER | TECHNICIAN | ADMIN | SYSTEM
  action       String // e.g. "technician_verified", "dispute_resolved", "payment_captured"
  entityType   String // booking | repair_job | quote | payment | dispute | technician | user
  entityId     String?
  metadataJson String? // safe metadata, no secrets
  createdAt    DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
}

// Technician earnings — aggregate for dashboard + admin.
model TechnicianEarnings {
  id                String            @id @default(cuid())
  technicianId      String            @unique
  technician        TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  totalEarnings     Int               @default(0) // minor units
  pendingPayouts    Int               @default(0)
  completedPayouts  Int               @default(0)
  jobsThisMonth     Int               @default(0)
  earningsThisMonth Int               @default(0)
  updatedAt         DateTime          @updatedAt
}

// ──────────────────────────── Phase 5: Production ──────────────────────────────

// Idempotency keys — prevent duplicate operations from retried requests.
model IdempotencyKey {
  id             String   @id @default(cuid())
  key            String   @unique
  userId         String
  operation      String // booking_create | payment_create | payment_capture | dispute_create | warranty_claim
  requestHash    String // hash of request body to detect different requests with same key
  responseStatus Int      @default(200)
  responseJson   String? // cached response for idempotent replay
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@index([userId, operation])
  @@index([expiresAt])
}

// Payment webhook events — idempotent webhook processing.
model PaymentWebhookEvent {
  id          String    @id @default(cuid())
  provider    String // stripe | chapa | mock
  eventId     String    @unique // provider's event ID
  eventType   String // payment_intent.succeeded | charge.refunded | etc.
  payloadHash String // hash of raw payload for dedup
  status      String    @default("PENDING") // PENDING | PROCESSED | FAILED
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@index([provider, eventType])
  @@index([status])
}

// Outbox events — reliable async processing (email, notifications, webhooks).
model OutboxEvent {
  id            String    @id @default(cuid())
  type          String // email | notification | webhook | analytics
  aggregateType String // booking | payment | dispute | etc.
  aggregateId   String?
  payload       String // JSON
  status        String    @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED
  attempts      Int       @default(0)
  maxAttempts   Int       @default(3)
  availableAt   DateTime  @default(now())
  processedAt   DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())

  @@index([status, availableAt])
  @@index([type, status])
}
